flowchart TD
    User["User: enters a request and reviews results"]
    App["CLI<br/>src/main.py"]
    Agent["Agent loop<br/>src/agent.py"]
    Parser["PLAN: offline keyword parser<br/>optional injected parse_request client"]
    Guardrail["Validate supported preferences<br/>genres, moods, numeric ranges"]
    Catalog[("Song catalog<br/>data/songs.csv")]
    Ranker["ACT: retrieve and rank<br/>src/recommender.py"]
    Evaluator["TEST: evaluate preference alignment<br/>match score and per-check results"]
    Decision{"Match score meets threshold?"}
    Retry["REFLECT: increase failing weights<br/>and retry within max_passes"]
    Human["Human review<br/>when request is unclear or score stays low"]
    Output["Recommendations, score reasons,<br/>warnings, and trace"]
    Logs["Application logs<br/>agent trace and review warnings"]

    User -->|"Natural-language request"| App
    App --> Agent
    Agent --> Parser
    Parser --> Guardrail
    Guardrail --> Ranker
    Catalog --> Ranker
    Ranker --> Evaluator
    Evaluator --> Decision
    Decision -->|"Yes"| Output
    Decision -->|"No; passes remain"| Retry
    Retry --> Ranker
    Decision -->|"No; final pass"| Human
    Guardrail -->|"No usable preferences"| Human
    Human --> Output
    Output --> User
    Agent -.-> Logs
    Human -.-> Logs

    subgraph Checks["Automated evaluation"]
        Tests["pytest<br/>tests/test_agent.py and tests/test_recommender.py"]
    end

    Tests -.->|"parser, validation, retries, CLI"| Agent
    Tests -.->|"ranking and weights"| Ranker
    Tests -.->|"match-score checks"| Evaluator
